{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["@cloudflare/workers-types"],
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,

		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		// #region pre-publication resolution for @drupflare/cartridge
		// These two entries point at the sibling working copy: the npm equivalent of the composer
		// `repositories` path entry the other half of this project uses.
		//
		// The dependency is deliberately NOT in package.json yet. It is not on npm, and declaring
		// `"@drupflare/cartridge": "0.x"` makes `bun install --frozen-lockfile` fail with a
		// registry 404, which is every CI run. Add it at publish time, together with deleting
		// these entries.
		//
		// ONLY the two subpaths this package imports are mapped, on purpose. The root entry pulls
		// `lazy-fs.ts`, which imports `fflate`, and `fflate` is not a dependency here -- mapping `.`
		// would drag a package this repo does not install into its own typecheck. `./gate` is
		// `serialize.ts` and `./mask` is `mask.ts`, and neither imports anything at all.
		//
		// DELETE BOTH once `@drupflare/cartridge` is published and installed; a stale path mapping
		// silently wins over node_modules, which is how a repo ends up typechecked against whatever
		// was in a sibling directory. The same entries exist in `vitest.config.ts` for the runtime
		// half, and the two must be changed together.
		"paths": {
			"@drupflare/cartridge/gate": ["../cartridge/src/serialize.ts"],
			"@drupflare/cartridge/mask": ["../cartridge/src/mask.ts"]
		}
		// #endregion
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules", "dist", "coverage"]
}
